{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vn-music-radar.local/schemas/model_contract_v1.json",
  "title": "VN Music Radar model API v1",
  "$comment": "Each endpoint request/response is a JSON Schema under $defs and referenced from endpoints. Embedding dimensions and citation membership also have runtime cross-field validation.",
  "$defs": {
    "entityType": { "type": "string", "enum": ["Person", "Group", "Song", "Album", "Company", "Show", "Event", "Brand"] },
    "relationType": { "type": "string", "enum": ["PERFORMED", "FEATURED_ON", "COMPOSED", "PRODUCED", "RELEASED_BY", "TRACK_OF", "MEMBER_OF", "CONTESTANT_ON", "JUDGE_ON", "PERFORMED_AT", "ORGANIZED_BY", "AMBASSADOR_OF", "COLLABORATED_WITH", "DISPUTED_WITH"] },
    "source": {
      "type": "object",
      "required": ["source_id", "text"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" }
      },
      "additionalProperties": true
    },
    "extractRequest": {
      "type": "object",
      "required": ["document_id", "schema_version", "text"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "const": "vn-music-radar.v1" },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mention": {
      "type": "object",
      "required": ["mention_id", "text", "type"],
      "properties": {
        "mention_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/entityType" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "extractedRelation": {
      "type": "object",
      "required": ["head_mention_id", "type", "tail_mention_id", "evidence", "confidence"],
      "properties": {
        "head_mention_id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/relationType" },
        "tail_mention_id": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Điểm SLM tự đánh giá, chưa hiệu chỉnh; chỉ lưu tham khảo, không dùng làm ngưỡng tự động nhận cạnh" }
      },
      "additionalProperties": false
    },
    "extractResponse": {
      "type": "object",
      "required": ["document_id", "schema_version", "model_version", "entities", "relations"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "const": "vn-music-radar.v1" },
        "model_version": { "type": "string", "minLength": 1 },
        "is_fixture": { "type": "boolean" },
        "fixture_text": { "type": "string" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/mention" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/extractedRelation" } }
      },
      "allOf": [{ "if": { "properties": { "is_fixture": { "const": true } }, "required": ["is_fixture"] }, "then": { "required": ["fixture_text"] } }],
      "additionalProperties": false
    },
    "embedRequest": {
      "type": "object",
      "required": ["schema_version", "texts"],
      "properties": {
        "schema_version": { "const": "vn-music-radar.v1" },
        "texts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "embedResponse": {
      "type": "object",
      "required": ["model_version", "dimensions", "vectors"],
      "properties": {
        "model_version": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1 },
        "vectors": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
      },
      "additionalProperties": false
    },
    "answerRequest": {
      "type": "object",
      "required": ["schema_version", "question", "context"],
      "properties": {
        "schema_version": { "const": "vn-music-radar.v1" },
        "question": { "type": "string", "minLength": 1 },
        "context": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      },
      "additionalProperties": true
    },
    "answerResponse": {
      "type": "object",
      "required": ["schema_version", "model_version", "answer", "source_ids"],
      "properties": {
        "schema_version": { "const": "vn-music-radar.v1" },
        "model_version": { "type": "string", "minLength": 1 },
        "answer": { "type": "string" },
        "source_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "summarizeRequest": {
      "type": "object",
      "required": ["schema_version", "items"],
      "properties": {
        "schema_version": { "const": "vn-music-radar.v1" },
        "community_id": { "type": ["string", "integer"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      },
      "additionalProperties": true
    },
    "summarizeResponse": {
      "type": "object",
      "required": ["schema_version", "summary", "source_ids", "model_version"],
      "properties": {
        "schema_version": { "const": "vn-music-radar.v1" },
        "summary": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "model_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "endpoints": {
    "/extract": { "request_schema": { "$ref": "#/$defs/extractRequest" }, "response_schema": { "$ref": "#/$defs/extractResponse" } },
    "/embed": { "request_schema": { "$ref": "#/$defs/embedRequest" }, "response_schema": { "$ref": "#/$defs/embedResponse" } },
    "/answer": { "request_schema": { "$ref": "#/$defs/answerRequest" }, "response_schema": { "$ref": "#/$defs/answerResponse" } },
    "/summarize": { "request_schema": { "$ref": "#/$defs/summarizeRequest" }, "response_schema": { "$ref": "#/$defs/summarizeResponse" } }
  },
  "relation_signatures": {
    "PERFORMED": [["Person", "Group"], ["Song"]],
    "FEATURED_ON": [["Person", "Group"], ["Song"]],
    "COMPOSED": [["Person"], ["Song"]],
    "PRODUCED": [["Person"], ["Song"]],
    "RELEASED_BY": [["Song", "Album"], ["Company"]],
    "TRACK_OF": [["Song"], ["Album"]],
    "MEMBER_OF": [["Person"], ["Group"]],
    "CONTESTANT_ON": [["Person"], ["Show"]],
    "JUDGE_ON": [["Person"], ["Show"]],
    "PERFORMED_AT": [["Person", "Group"], ["Show", "Event"]],
    "ORGANIZED_BY": [["Show", "Event"], ["Company"]],
    "AMBASSADOR_OF": [["Person", "Group"], ["Brand"]],
    "COLLABORATED_WITH": [["Person", "Group"], ["Person", "Group"]],
    "DISPUTED_WITH": [["Person", "Group", "Company"], ["Person", "Group", "Company"]]
  },
  "rules": [
    "Each /extract result has one document_id, one schema_version and one model_version.",
    "Each mention_id is unique within its document; relations reference mention_id values from that result.",
    "Mention text and relation evidence are literal substrings of the original document text.",
    "Embedding vector count equals input text count and every vector length equals dimensions; dimensions stay fixed for one model_version.",
    "The answer service receives supplied context and source_ids must be a subset of supplied source_id values.",
    "Fixture rows are marked is_fixture=true, include fixture_text and are excluded from real evaluation and graph import.",
    "Relationship direction and endpoint types follow relation_signatures; COLLABORATED_WITH and DISPUTED_WITH are symmetric."
  ]
}
